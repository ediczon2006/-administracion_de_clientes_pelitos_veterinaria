# Plantilla de configuración de credenciales para Pelitos Veterinaria CRM
# =======================================================================
# 1. Copie este archivo como `.streamlit/secrets.toml` (este archivo está ignorado por Git).
# 2. Genere sus hashes PBKDF2-SHA256 con:
#        python -m modules.auth
# 3. En Streamlit Community Cloud, pegue el mismo contenido en Settings -> Secrets.
# NUNCA suba contraseñas ni hashes reales al repositorio Git.

[auth.users.admin]
nombre = "Administrador Pelitos"
role = "admin"
password_hash = "pbkdf2_sha256$260000$REEMPLAZAR_CON_SALT_HEX$REEMPLAZAR_CON_HASH_HEX"

[auth.users.recepcion]
nombre = "Recepción Pelitos"
role = "operador"
password_hash = "pbkdf2_sha256$260000$REEMPLAZAR_CON_SALT_HEX$REEMPLAZAR_CON_HASH_HEX"
